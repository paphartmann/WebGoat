<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration>
  <context>
    <name>WebGoat</name>
    <desc>Authenticated ZAP scan of the disposable WebGoat CI user.</desc>
    <inscope>true</inscope>
    <incregexes>http://127\.0\.0\.1:8080/WebGoat(/.*)?</incregexes>
    <excregexes>http://127\.0\.0\.1:8080/WebGoat/logout</excregexes>
    <authentication>
      <type>2</type>
      <strategy>EACH_RESP</strategy>
      <pollurl/>
      <polldata/>
      <form>
        <loginurl>http://127.0.0.1:8080/WebGoat/login</loginurl>
        <loginbody>username={%username%}&amp;password={%password%}</loginbody>
        <loginpageurl>http://127.0.0.1:8080/WebGoat/login</loginpageurl>
      </form>
      <loggedin>id="user-menu"</loggedin>
      <loggedout>name='username'</loggedout>
    </authentication>
    <users>
      <user>1;true;emFwc2Nhbm5lcg==;3;emFwc2Nhbm5lcg==~d2ViZ29hdA==~</user>
    </users>
    <forceduser>-1</forceduser>
    <session>
      <type>0</type>
    </session>
    <authorization>
      <type>0</type>
      <basic>
        <header/>
        <body/>
        <logic>AND</logic>
        <code>-1</code>
      </basic>
    </authorization>
  </context>
</configuration>
